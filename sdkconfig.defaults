# IDF options of [env:jc3248w535_tls], the only environment built on the ESP-IDF framework
# (the Arduino ones ignore this file). Values are those of the Arduino core's own
# esp32s3/qio_opi build (tools/sdk/esp32s3/qio_opi/include/sdkconfig.h) plus the experiment.

# What the Arduino core needs when it is built as an IDF component
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y

# The board: 16 MB QIO flash, 8 MB octal PSRAM. As in the prebuilt core, malloc() above 4 KB may
# come from PSRAM and the Wi-Fi/lwIP buffers try it first (already so in the Arduino builds)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# The rest of the prebuilt core's choices that differ from the IDF defaults, so that a heap or
# speed difference to the Arduino builds comes from the experiment: 240 MHz, size-optimised IDF
# libraries, error-only logs, 8 + 8 static Wi-Fi buffers (16 + 16 by default: ~26 KB of RAM)
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_TX_BA_WIN=6
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=0

# The experiment: the TLS buffers (~46 KB) into PSRAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
