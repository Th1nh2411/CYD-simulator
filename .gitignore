.pio/
# What PlatformIO writes for the ESP-IDF based environment; the options are in sdkconfig.defaults
/sdkconfig.*
!/sdkconfig.defaults
# Test certificates and keys for mutual TLS (tools/mqtt/make_certs.py)
tools/mqtt/certs/
# web simulator output (tools/web/sim.py)
build/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
refs/
# factory firmware dump of this specific board (4 MB, kept locally)
backup/

# Font sources (fetched by hand, see tools/font/bdf2font.py); the converted table is in src/app/gfx/fonts/
tools/font/galmuri/

# Heroine art made from the sources by tools/rig (cutout.py, frames.py); the sources are
# art/heroine/base_source.webp and art/heroine/src/
art/heroine/*.png
__pycache__/
# Settings each step of tools/rig/convert.py last ran with
art/*/.convert.json

# Python tools (simulator, art converters): python3 -m venv .venv
.venv/
